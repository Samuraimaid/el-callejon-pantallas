{
  "files.exclude": {
    "**/__pycache__": true,
    "**/node_modules": true
  },
  "editor.formatOnSave": true,
  "docker.composeCommand": "docker compose",
  "[python]": {
    "editor.defaultFormatter": "ms-python.python"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
