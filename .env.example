# PostgreSQL
POSTGRES_USER=callejon
POSTGRES_PASSWORD=callejon_dev_2026
POSTGRES_DB=el_callejon_pos
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://callejon:callejon_dev_2026@db:5432/el_callejon_pos
# "*" permite orígenes de la red local (cartelería). Alternativa: lista de URLs.
CORS_ORIGINS=*
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRE_MINUTES=720

# Frontend — accesible en la LAN: http://IP_DEL_SERVIDOR:5173
FRONTEND_PORT=5173
# auto = API/WS usan el mismo host que abrió el TV (vía proxy Vite, un solo puerto)
VITE_API_URL=auto
VITE_WS_URL=auto
# Si prefiere forzar IP fija (sin proxy same-origin), use por ejemplo:
# VITE_API_URL=http://192.168.1.129:8000
# VITE_WS_URL=ws://192.168.1.129:8000/ws
